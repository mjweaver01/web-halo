{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "halo-web-signaling",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Safe-by-default deployment settings. The exact public game origin is
    // allowed alongside the two deterministic local-development origins.
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "https://halo-web.mjweaver01.workers.dev,http://127.0.0.1:8765,http://localhost:8765",
    "ALLOW_NO_ORIGIN": "false",
    "PUBLIC_GAME_URL": "https://halo-web.mjweaver01.workers.dev",
    "ROOM_TTL_SECONDS": "21600",
    "SESSION_TTL_SECONDS": "30",
    "TURN_TTL_SECONDS": "3600",
    "TURNSTILE_HOSTNAMES": "halo-web.mjweaver01.workers.dev",
    "CLOUDFLARE_ACCOUNT_ID": "4303a98c4737bbefefd029227c5e1b7b",
    "TURN_ACTOR_HOURLY_EGRESS_CAP_BYTES": "1000000000",
    "TURN_GLOBAL_DAILY_EGRESS_CAP_BYTES": "10000000000",
    "DEFAULT_ROOM_CAPACITY": "128",
    "MAX_ROOM_CAPACITY": "128"
  },
  "workers_dev": true,
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "HALO_ABUSE",
      "id": "b4729df09aed488ea0515d28f62815ae"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "TURN_EVENTS",
      "dataset": "halo_turn_events"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "SignalingRoom"
      },
      {
        "name": "PRESENCE",
        "class_name": "PlayerPresence"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "ROOM_CREATE_LIMITER",
      "namespace_id": "41001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "SESSION_CREATE_LIMITER",
      "namespace_id": "41002",
      "simple": {
        "limit": 512,
        "period": 60
      }
    },
    {
      "name": "TURN_ISSUE_LIMITER",
      "namespace_id": "41003",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SignalingRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["PlayerPresence"]
    }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
